PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (the frontend's dev/prod URL)
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API. 0 in local dev; 1 behind Nginx; 2 behind host Nginx + container Nginx.
TRUST_PROXY=0

# Optional: Google sign-in. The ID token is verified with Google, so this must match your OAuth client ID,
# and your site's https:// origin must be an Authorized JavaScript origin in Google Cloud Console.
# Leave unset to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Optional: SMTP credentials for sending real emails (meeting invites/cancellations).
# Leave SMTP_HOST unset to disable email sending entirely — in-app notifications still work either way.
# Example for Gmail: host smtp.gmail.com, port 587, secure false, and an App Password (not your normal password) as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PDC ERP <no-reply@yourcompany.com>

# Optional: real Instagram data in the Marketing Analytics module, via Instagram Graph API OAuth.
# Leave META_APP_ID unset to keep that module on manual entry — nothing else breaks either way.
#
# Setup (one-time, ~20 min):
#  1. Create a free app at https://developers.facebook.com/apps (type: "Business").
#  2. Add the "Instagram Graph API" and "Facebook Login for Business" products to it.
#  3. Under Facebook Login settings, add META_REDIRECT_URI below as a valid OAuth redirect URI.
#  4. Copy the App ID and App Secret from the app's Settings > Basic page.
#  5. Each client's Instagram must be a Business/Creator account linked to a Facebook Page they control.
#  6. While the app is in Development Mode, only Admins/Testers added to the app (in its Roles settings)
#     can complete the connect flow — fine for trying this out. Meta App Review is required before
#     clients themselves (or anyone outside your team) can be connected in production.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/instagram/callback
META_GRAPH_VERSION=v23.0
# Where the backend redirects back to after the OAuth popup finishes (your frontend's URL).
FRONTEND_URL=http://localhost:5173

# Required before connecting any Instagram account: a 32-byte key (base64 or hex) used to encrypt
# the stored access token at rest. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INSTAGRAM_TOKEN_KEY=
