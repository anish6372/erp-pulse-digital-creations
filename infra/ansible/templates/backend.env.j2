PORT=4000
HOST=0.0.0.0
NODE_ENV=production
# Two proxies sit in front of the API: host Nginx, then the frontend container's Nginx.
TRUST_PROXY=2
CORS_ORIGIN=https://{{ domain_name }}
FRONTEND_URL=https://{{ domain_name }}

# Optional. Leave blank to disable. Any Google account that signs in becomes an Employee.
GOOGLE_CLIENT_ID=

# Optional: email for meeting and onboarding invites
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PDC ERP <no-reply@{{ domain_name }}>

# Optional: Instagram module. Generate the key once and back it up.
INSTAGRAM_TOKEN_KEY=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://{{ domain_name }}/api/instagram/callback
